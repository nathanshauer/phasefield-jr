    RowBox[{"\[CurlyPhi]1", "[", "\[Xi]", "]"}], 
    RowBox[{"\[CurlyPhi]0", "[", "\[Eta]", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
