  RowBox[{"\[Phi]2", "=", 
   RowBox[{
    RowBox[{"\[CurlyPhi]1", "[", "\[Xi]", "]"}], 
    RowBox[{"\[CurlyPhi]1", "[", "\[Eta]", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
