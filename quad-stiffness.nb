   ";"}], "\[IndentingNewLine]", 
 RowBox[{"jac", "//", "MatrixForm"}], "\[IndentingNewLine]", 
 RowBox[{"detjac", "=", 
  RowBox[{"Det", "[", "jac", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"invjac", "=", 
   RowBox[{
